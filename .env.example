# =============================================================================
# NutriFlow — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# =============================================================================

# --- Supabase (Auth + DB + Storage) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Database (Supabase Postgres via Prisma) ---
# Direct connection (for migrations)
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
# Pooled connection (for serverless/edge functions)
DATABASE_URL_POOLED=postgresql://postgres:[password]@[project-ref].pooler.supabase.com:6543/postgres?pgbouncer=true

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=NutriFlow

# --- Sentry Error Monitoring (Phase 4) ---
SENTRY_DSN=your-sentry-dsn
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=nutriflow

# --- PostHog Analytics (Phase 4) ---
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# --- Rate Limiting (Phase 4) ---
# Optional: Upstash Redis for distributed rate limiting
UPSTASH_REDIS_REST_URL=your-upstash-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
